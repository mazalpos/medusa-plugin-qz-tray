{
  "name": "medusa-plugin-qz-tray",
  "version": "0.1.0",
  "description": "Print receipts from Medusa Admin straight to a thermal printer with QZ Tray: signed requests, no print dialog, no Allow pop-ups.",
  "author": "MazalPOS (https://mazalpos.com)",
  "license": "MIT",
  "files": [
    ".medusa/server"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./workflows": "./.medusa/server/src/workflows/index.js",
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./modules/*": "./.medusa/server/src/modules/*/index.js",
    "./providers/*": "./.medusa/server/src/providers/*/index.js",
    "./*": "./.medusa/server/src/*.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "keywords": [
    "medusa-v2",
    "medusa-plugin-integration",
    "medusa-plugin-other",
    "medusa-plugin",
    "medusa",
    "qz-tray",
    "receipt-printer",
    "thermal-printer",
    "pos",
    "point-of-sale"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "lint": "medusa lint",
    "prepublishOnly": "medusa plugin:build"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.19.0",
    "@medusajs/cli": "2.19.0",
    "@medusajs/eslint-plugin": "2.19.0",
    "@medusajs/framework": "2.19.0",
    "@medusajs/icons": "2.19.0",
    "@medusajs/medusa": "2.19.0",
    "@medusajs/test-utils": "2.19.0",
    "@medusajs/ui": "4.2.1",
    "@swc/core": "^1.7.28",
    "@types/node": "^20.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "eslint": "^9.0.0",
    "jiti": "^2.0.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.6",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": ">=2.19.0",
    "@medusajs/cli": ">=2.19.0",
    "@medusajs/framework": ">=2.19.0",
    "@medusajs/icons": ">=2.19.0",
    "@medusajs/medusa": ">=2.19.0",
    "@medusajs/ui": ">=4.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "node-forge": "^1.4.2",
    "qz-tray": "^2.3.0"
  },
  "homepage": "https://mazalpos.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mazalpos/medusa-plugin-qz-tray.git"
  },
  "bugs": {
    "url": "https://github.com/mazalpos/medusa-plugin-qz-tray/issues"
  }
}
